<!DOCTYPE html>
<html>
<head>
    <title>Password Strength Checker</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #eef6ff;
            text-align: center;
            padding-top: 60px;
        }

        .box {
            background: white;
            width: 420px;
            margin: auto;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 0 15px #ccc;
        }

        input {
            width: 90%;
            padding: 12px;
            font-size: 16px;
            margin: 15px 0;
        }

        button {
            padding: 12px 20px;
            background: #0066cc;
            color: white;
            border: none;
            cursor: pointer;
            border-radius: 6px;
        }

        #result {
            margin-top: 20px;
            font-size: 22px;
            font-weight: bold;
        }

        #details {
            text-align: left;
            margin-top: 20px;
            line-height: 1.8;
        }

        .weak { color: red; }
        .medium { color: orange; }
        .strong { color: green; }
    </style>
</head>

<body>

    <div class="box">
        <h2>Password Strength Checker 🔐</h2>

        <input type="password" id="password" placeholder="Enter your password">

        <br>

        <button onclick="checkPassword()">Check Strength</button>

        <h3 id="result"></h3>

        <div id="details"></div>
    </div>

    <script>
        function checkPassword() {
            let password = document.getElementById("password").value;
            let result = document.getElementById("result");
            let details = document.getElementById("details");

            let hasUppercase = /[A-Z]/.test(password);
            let hasNumber = /[0-9]/.test(password);
            let hasSymbol = /[^A-Za-z0-9]/.test(password);
            let hasUnicode = /[^\x00-\x7F]/.test(password);

            let commonPasswords = ["password", "12345678", "qwerty", "admin123", "password123"];

            let score = 0;

            if (password.length >= 8) score++;
            if (hasUppercase) score++;
            if (hasNumber) score++;
            if (hasSymbol) score++;
            if (hasUnicode) score++;

            details.innerHTML = `
                <b>Password Analysis:</b><br>
                Length 8 or more: ${password.length >= 8 ? "✅ Yes" : "❌ No"}<br>
                Uppercase letter A-Z: ${hasUppercase ? "✅ Yes" : "❌ No"}<br>
                Number 0-9: ${hasNumber ? "✅ Yes" : "❌ No"}<br>
                Symbol: ${hasSymbol ? "✅ Yes" : "❌ No"}<br>
                Unicode character: ${hasUnicode ? "✅ Yes" : "❌ No"}<br>
                Common password check: ${commonPasswords.includes(password.toLowerCase()) ? "❌ Common password" : "✅ Not common"}
            `;

            if (password.length < 8) {
                result.innerHTML = "Weak Password: Less than 8 characters";
                result.className = "weak";
                return;
            }

            if (commonPasswords.includes(password.toLowerCase())) {
                result.innerHTML = "Weak Password: Too common";
                result.className = "weak";
                return;
            }

            if (score <= 2) {
                result.innerHTML = "Weak Password";
                result.className = "weak";
            } 
            else if (score <= 4) {
                result.innerHTML = "Medium Password";
                result.className = "medium";
            } 
            else {
                result.innerHTML = "Strong Password";
                result.className = "strong";
            }
        }
    </script>

</body>
</html>
